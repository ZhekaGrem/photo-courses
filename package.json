{
  "name": "fotocurse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir .test-build --rootDir src --noEmit false --incremental false --module commonjs --moduleResolution node --target es2022 --skipLibCheck --esModuleInterop --allowJs src/lib/leads.ts src/lib/analytics.ts && node --test tests/*.test.cjs",
    "prepare:images": "node scripts/prepare-images.cjs",
    "predev": "npm run prepare:images",
    "prebuild": "npm run prepare:images"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "autoprefixer": "^10.4.19",
    "cloudinary": "^2.6.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "framer-motion": "^11.2.13",
    "husky": "^9.1.4",
    "keen-slider": "^6.8.6",
    "next": "^14.2.5",
    "next-cloudinary": "^6.16.0",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.4",
    "swiper": "^11.1.8",
    "tailwindcss-textshadow": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
